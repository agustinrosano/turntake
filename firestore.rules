rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Validar si el usuario es el dueño del negocio
    function isOwner(businessId) {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == businessId;
    }

    // Colección: Perfiles de Usuario (Administradores)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Colección: Registro de Slugs (Público para lectura, Protegido para escritura)
    match /slug_registry/{slug} {
      allow read: if true; // Cualquiera puede leer el businessId de un slug para cargar el portal
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/slug_registry/$(slug));
      allow update, delete: if isOwner(resource.data.businessId);
    }

    // Colección: Negocios (Businesses) y sus subcolecciones
    match /businesses/{businessId} {
      allow read: if true; // Los clientes necesitan leer el perfil público
      allow write: if isOwner(businessId);

      // Subcolección: Turnos (Appointments)
      match /appointments/{appointmentId} {
        // Los clientes pueden ver turnos ocupados para filtrar disponibilidad
        allow read: if true; 
        
        // Los clientes pueden crear un turno
        allow create: if true; 
        
        // Solo el dueño puede modificar/cancelar/confirmar turnos
        allow update, delete: if isOwner(businessId);
      }

      // Subcolección: Clientes
      match /customers/{customerId} {
        allow read, write: if isOwner(businessId);
      }
    }

    // Colección: Errores (Errors) - Escritura pública para logging de fallos, lectura protegida
    match /errors/{errorId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
